      "name": "offlineAuth.service.ts",
      "filePath": "frontend/src/services/offlineAuth.service.ts",
      "summary": "Manages encrypted offline authentication sessions: derives a per-device AES key via WebCrypto, encrypts/decrypts the stored session token, and tracks session validity/expiration for offline login.",
      "tags": ["service", "offline", "security", "authentication"],
      "complexity": "complex",
      "languageNotes": "Uses the WebCrypto SubtleCrypto API (PBKDF2 key derivation + AES-GCM) to encrypt the offline session token at rest, keyed off a per-device UUID stored in localStorage."
    },
