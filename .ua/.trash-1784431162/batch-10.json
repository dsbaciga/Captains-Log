      "type": "file",
      "name": "tripValidator.service.ts",
      "filePath": "backend/src/services/tripValidator.service.ts",
      "summary": "Implements the Trip Health Check engine that scans a trip for issues such as timeline conflicts, missing lodging/transportation, empty days, expiring passports, and unmet visa requirements, and manages dismissing/restoring individual issues.",
      "tags": ["service", "validation", "business-logic", "trip-management"],
      "complexity": "complex",
      "languageNotes": "Uses a rule-based validation engine pattern: validateTrip() aggregates results from a series of independent checkXxx() methods, each returning typed issue objects that are then grouped by category and filtered against a dismissed-issues set."
    },
    {
      "id": "class:backend/src/services/tripValidator.service.ts:TripValidatorService",
      "type": "class",
      "name": "TripValidatorService",
      "filePath": "backend/src/services/tripValidator.service.ts",
      "lineRange": [123, 911],
      "summary": "Singleton service exposing validateTrip, dismissIssue, restoreIssue, and getQuickStatus plus a battery of private checkXxx() rules that detect trip-planning problems (timeline conflicts, missing lodging/transportation, empty days, travel-time alerts, passport/visa issues).",
      "tags": ["service", "validation", "singleton", "business-logic"],
      "complexity": "complex"
    },
