# =============================================================================
# Travel Life — TrueNAS Scale environment
# =============================================================================
# Used with either TrueNAS compose file:
#   docker-compose -f docker-compose.truenas.yml --env-file .env.truenas up -d
#   docker-compose -f docker-compose.truenas.optimized.yml --env-file .env.truenas up -d
#
# Copy to .env.truenas and fill in. That filename is gitignored; this template
# is not, so never put real values here.
#
# The .optimized variant drops the self-hosted Nominatim container and uses the
# public service instead — much lower idle resource usage.
# -----------------------------------------------------------------------------


# =============================================================================
# REQUIRED — compose refuses to start without these
# =============================================================================

DB_USER=travel_life_user
DB_PASSWORD=
DB_NAME=travel_life

# Generate each with: openssl rand -base64 48
# Changing these invalidates every existing session.
JWT_SECRET=
JWT_REFRESH_SECRET=

# NOTE ON ROTATING DB_PASSWORD: POSTGRES_PASSWORD only takes effect when
# Postgres FIRST initialises its data directory. On an existing volume,
# changing it here will not change the actual password — the app will just
# fail to connect. To genuinely rotate:
#   docker exec -it travel-life-db psql -U travel_life_user -d travel_life \
#     -c "ALTER USER travel_life_user WITH PASSWORD 'new-password';"
# then update this value and redeploy.
#
# If the password contains URL-reserved characters (@ : / ? #) it must be
# percent-encoded where it is interpolated into DATABASE_URL.


# =============================================================================
# TrueNAS storage
# =============================================================================
# Parent dataset holding postgres/, uploads/, logs/, nominatim/.
# Create these datasets before first start.

TRUENAS_DATA_PATH=/mnt/main_pool/travel-life


# =============================================================================
# Host ports
# =============================================================================

FRONTEND_PORT=30600
BACKEND_PORT=30601
NOMINATIM_PORT=30602
DB_PORT=30603


# =============================================================================
# Networking
# =============================================================================

# REQUIRED in practice: the public URL you reach the app on. Without a matching
# CORS_ORIGIN, browser requests from your domain are blocked.
CORS_ORIGIN=https://travellife.example.com
BASE_URL=https://travellife.example.com
FRONTEND_URL=https://travellife.example.com

# Geocoding. The .optimized compose defaults to the public service; the full
# compose defaults to the bundled container at http://nominatim:8080.
NOMINATIM_URL=


# =============================================================================
# Optional integrations — each feature is inert when its keys are unset
# =============================================================================

# Immich photo library — reachable from inside the container, so use the LAN
# address of the Immich host rather than localhost.
IMMICH_API_URL=
IMMICH_API_KEY=

OPENWEATHERMAP_API_KEY=
AVIATIONSTACK_API_KEY=

# Road distances (openrouteservice.org). Without this, distances fall back to
# straight-line Haversine calculations.
OPENROUTESERVICE_API_KEY=


# =============================================================================
# Saved-link email ingest (IMAP) — optional
# =============================================================================
# Forward a link to the ingest mailbox and it lands in your saved-links inbox.
# Entirely inert unless IMAP_USER and IMAP_PASSWORD are both set.
#
# For Gmail, IMAP_PASSWORD must be a 16-character App Password with the spaces
# removed — NOT the account password. Requires 2-Step Verification on the
# account: https://myaccount.google.com/apppasswords
# Also confirm IMAP is on under Gmail -> Settings -> Forwarding and POP/IMAP.
#
# A message is only accepted when its From address matches a user's account
# email or one of their trusted addresses (Settings -> Link Ingest). A From
# header is forgeable, so treat the mailbox address itself as the secret.
#
# Verify it took after deploying:
#   docker logs travel-life-backend | grep -i "link ingest"
# Expect: Email link ingest enabled (schedule: */5 * * * *)

IMAP_USER=
IMAP_PASSWORD=

# Defaults below are correct for Gmail; leave unset unless you need to change them.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
# Processed mail is MOVED here, not deleted. '[Gmail]/All Mail' is Gmail's archive.
IMAP_ARCHIVE_FOLDER=[Gmail]/All Mail
IMAP_POLL_CRON=*/5 * * * *
IMAP_MAX_LINKS=20


# =============================================================================
# Other optional settings
# =============================================================================
# The TrueNAS compose files do not currently pass these through to the backend.
# If you need them, add the matching lines to the service's `environment:` block
# as well — a value here alone will not reach the container.
#
# OIDC single sign-on:  OIDC_ISSUER_URL, OIDC_CLIENT_ID, OIDC_CLIENT_SECRET,
#                       OIDC_REDIRECT_URL, OIDC_SCOPES, OIDC_BUTTON_TEXT,
#                       OIDC_AUTO_PROVISION, OIDC_TRUST_EMAIL,
#                       DISABLE_PASSWORD_LOGIN
# Web push:             VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, VAPID_SUBJECT
# AI features:          AI_ENABLED, LLM_API_KEY, LLM_BASE_URL, LLM_MODEL,
#                       LLM_MAX_TOKENS, AI_RATE_LIMIT_MAX, AI_RATE_LIMIT_WINDOW_MS
# Outbound email:       SMTP_HOST, SMTP_PORT, SMTP_SECURE, SMTP_USER,
#                       SMTP_PASSWORD, SMTP_FROM
#
# See .env.production.example (used with docker-compose.prod.yml) for the full
# annotated list — that compose file passes all of them through already.
