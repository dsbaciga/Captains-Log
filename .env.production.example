# =============================================================================
# Travel Life — production environment
# =============================================================================
# Used with: docker-compose -f docker-compose.prod.yml --env-file .env.production up -d
#
# Copy to .env.production and fill in. That filename is gitignored; this
# template is not, so never put real values here.
#
# IMPORTANT: docker-compose.prod.yml uses ${VAR} interpolation. A variable set
# here only reaches the backend container if it is ALSO listed in the service's
# `environment:` block. If you add a new variable, add it in both places.
# -----------------------------------------------------------------------------


# =============================================================================
# REQUIRED — compose refuses to start without these
# =============================================================================

# Postgres. DB_PASSWORD is also interpolated into DATABASE_URL, so if it
# contains URL-reserved characters (@ : / ? #) percent-encode it there.
DB_USER=travel_life_user
DB_PASSWORD=
DB_NAME=travel_life

# Generate each with: openssl rand -base64 48
# Changing these invalidates every existing session.
JWT_SECRET=
JWT_REFRESH_SECRET=


# =============================================================================
# Networking
# =============================================================================

# Public URL of the API. Required for OIDC redirects and absolute links.
BASE_URL=https://travellife.example.com
# Public URL of the frontend. Required for post-login redirects.
FRONTEND_URL=https://travellife.example.com

# Browser origins allowed to call the API, comma-separated. Only needed when the
# frontend is served from a different origin — the bundled nginx proxies /api
# and /uploads, so same-domain deployments can leave this unset.
CORS_ORIGIN=

# strict | lax | none. Use `lax` if frontend and API are on different subdomains.
COOKIE_SAME_SITE=strict
# e.g. .example.com to share cookies across subdomains. Leave unset otherwise.
COOKIE_DOMAIN=

# Host ports
BACKEND_PORT=5000
FRONTEND_PORT=80
NOMINATIM_PORT=8080

# Baked into the frontend bundle at BUILD time, not runtime. Changing these
# requires a rebuild, not just a restart.
VITE_API_URL=/api
VITE_UPLOAD_URL=/uploads


# =============================================================================
# Token & upload tuning (optional — sensible defaults if unset)
# =============================================================================

JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Bytes. Default 52428800 (50MB).
MAX_FILE_SIZE=


# =============================================================================
# Geocoding
# =============================================================================

# Self-hosted Nominatim (the bundled container). To use the public service
# instead and drop the container, set https://nominatim.openstreetmap.org —
# but respect their usage policy.
NOMINATIM_URL=http://nominatim:8080

# First-run import for the bundled Nominatim. Takes 1-2 hours for full US.
# A smaller region is much faster, e.g.
#   https://download.geofabrik.de/north-america/us/california-latest.osm.pbf
NOMINATIM_PBF_URL=
NOMINATIM_REPLICATION_URL=


# =============================================================================
# Optional integrations — each feature is inert when its keys are unset
# =============================================================================

# Immich photo library
IMMICH_API_URL=
IMMICH_API_KEY=

# Weather (openweathermap.org)
OPENWEATHERMAP_API_KEY=

# Flight tracking (aviationstack.com)
AVIATIONSTACK_API_KEY=

# Road distances (openrouteservice.org). Without this, distances fall back to
# straight-line Haversine calculations.
OPENROUTESERVICE_API_KEY=
OPENROUTESERVICE_URL=


# =============================================================================
# Single sign-on (OIDC) — optional
# =============================================================================
# Enabled when OIDC_ISSUER_URL and OIDC_CLIENT_ID are both set. PKCE (S256) is
# always used. Register <BASE_URL>/api/auth/oidc/callback with your provider.

OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
# Omit for public clients (PKCE only)
OIDC_CLIENT_SECRET=
# Defaults to <BASE_URL>/api/auth/oidc/callback
OIDC_REDIRECT_URL=
OIDC_SCOPES=openid profile email
OIDC_BUTTON_TEXT=Sign in with SSO
# false requires an account to already exist before first SSO sign-in
OIDC_AUTO_PROVISION=
# true allows linking by email when the IdP omits email_verified entirely.
# An explicit email_verified:false is always rejected. Only enable when you
# fully control the IdP.
OIDC_TRUST_EMAIL=

# SSO-only mode: refuses password login and registration, and hides them from
# the login page. Ignored unless OIDC is enabled — that guard is what stops a
# stray value here from locking you out entirely.
DISABLE_PASSWORD_LOGIN=


# =============================================================================
# Web push notifications — optional
# =============================================================================
# Generate a key pair with: npx web-push generate-vapid-keys
# Push is silently disabled when these are unset.

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Must be a mailto: URI
VAPID_SUBJECT=mailto:admin@example.com


# =============================================================================
# AI features (PDF import, link suggestions, journal summaries) — optional
# =============================================================================
# Users can also supply their own key in Settings. AI_ENABLED=false turns the
# features off entirely regardless of keys.

AI_ENABLED=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=2048
AI_RATE_LIMIT_MAX=20
AI_RATE_LIMIT_WINDOW_MS=3600000

# Backup/restore endpoint rate limiting
BACKUP_RATE_LIMIT_MAX=
BACKUP_RATE_LIMIT_WINDOW_MS=


# =============================================================================
# Outbound email (SMTP) — optional
# =============================================================================
# Instance-wide fallback for invitation mail; users can override per-account in
# Settings. Invitations still work when unset — they just report emailSent=false
# so the inviter shares the link manually.

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Travel Life <noreply@example.com>


# =============================================================================
# Saved-link email ingest (IMAP) — optional
# =============================================================================
# Forward a link to the ingest mailbox and it lands in your saved-links inbox.
# Entirely inert unless IMAP_USER and IMAP_PASSWORD are both set.
#
# For Gmail, IMAP_PASSWORD must be a 16-character App Password with the spaces
# removed — NOT the account password. Requires 2-Step Verification on the
# account: https://myaccount.google.com/apppasswords
# Also confirm IMAP is on under Gmail -> Settings -> Forwarding and POP/IMAP.
#
# A message is only accepted when its From address matches a user's account
# email or one of their trusted addresses (Settings -> Link Ingest). A From
# header is forgeable, so treat the mailbox address itself as the secret.

IMAP_USER=
IMAP_PASSWORD=

# Defaults below are correct for Gmail; leave unset unless you need to change them.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
# Processed mail is MOVED here, not deleted. '[Gmail]/All Mail' is Gmail's archive.
IMAP_ARCHIVE_FOLDER=[Gmail]/All Mail
IMAP_POLL_CRON=*/5 * * * *
IMAP_MAX_LINKS=20
